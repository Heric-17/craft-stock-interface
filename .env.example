# Base URL of the CraftStock API, without a trailing slash.
# The API mounts every route at the root: /auth/login, /materials, /sales, ...
#
# The session's refresh token travels in an HttpOnly cookie with SameSite=Lax,
# so in production the SPA and the API must sit on the SAME REGISTRABLE SITE —
# app.empresa.com.br and api.empresa.com.br, both under empresa.com.br. Two
# subdomains of onrender.com (or vercel.app, netlify.app, github.io) do NOT
# qualify: those hosts are on the Public Suffix List, each subdomain counts as a
# separate site, and the browser then refuses to send the cookie on the POST to
# /auth/refresh. The session would silently stop surviving a reload, with no
# error anywhere. Every installation therefore needs its own domain.
#
# In development this is already satisfied: localhost:5173 and localhost:3000
# differ only by port, and site matching ignores the port.
VITE_API_URL=http://localhost:3000

# Company name shown in the shell. One build per installation: there is no
# company switcher, no plan and no tenant selector.
VITE_COMPANY_NAME=Ateliê da Marina
